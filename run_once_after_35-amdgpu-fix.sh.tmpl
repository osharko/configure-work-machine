{{- if .disable_amdgpu_psr -}}
#!/usr/bin/env bash
# AMDGPU PSR disable — workaround flicker iGPU Radeon (Krackan/RDNA 3.5).
# Aggiunge `amdgpu.dcdebugmask=0x10` alla cmdline della entry `linux-cachyos`
# in /boot/limine.conf (NON tocca le snapshots). Gated da flag .disable_amdgpu_psr.
set -euo pipefail

LIMINE=/boot/limine.conf
PARAM='amdgpu.dcdebugmask=0x10'

if ! sudo test -f "$LIMINE"; then
    echo "→ $LIMINE assente — skip (boot loader diverso?)"
    exit 0
fi

if ! sudo grep -q "//linux-cachyos$" "$LIMINE" 2>/dev/null; then
    echo "→ entry '//linux-cachyos' non trovata in $LIMINE — skip"
    exit 0
fi

# Verifico se il param è già presente in una entry kernel (non snapshot)
if sudo grep -q "rootflags=subvol=/@ .* $PARAM" "$LIMINE" 2>/dev/null; then
    echo "✓ amdgpu PSR disable già presente in $LIMINE"
    exit 0
fi

BACKUP="$LIMINE.bak.$(date +%s)"
sudo cp "$LIMINE" "$BACKUP"
echo "→ backup creato: $BACKUP"

# Aggiungo $PARAM in coda alla riga `cmdline:` delle entry kernel (linux-cachyos + lts)
# Matcha solo rootflags=subvol=/@ seguito da spazio (esclude snapshot che hanno /@/.snapshots/)
sudo sed -i '/rootflags=subvol=\/@ /{'"$PARAM"'/!s|$| '"$PARAM"'|}' "$LIMINE"

echo "→ amdgpu PSR disable applicato in $LIMINE (reboot per attivare)"
{{- else -}}
#!/usr/bin/env bash
# .disable_amdgpu_psr = false → no-op
echo "→ disable_amdgpu_psr=false → skip patch limine.conf"
{{- end -}}
