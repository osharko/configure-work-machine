{{- if .disable_amdgpu_psr -}}
#!/usr/bin/env bash
# AMDGPU flicker workaround — iGPU Radeon (Krackan/RDNA 3.5).
# Aggiunge alla cmdline di /boot/limine.conf (NON tocca le snapshots):
#   amdgpu.dcdebugmask=0x10  — disabilita PSR (Panel Self Refresh)
#   amdgpu.dpm=0             — disabilita power management dinamico (clock fisso)
# Gated da flag .disable_amdgpu_psr.
set -euo pipefail

LIMINE=/boot/limine.conf
PARAMS='amdgpu.dcdebugmask=0x10 amdgpu.dpm=0'

if ! sudo test -f "$LIMINE"; then
    echo "→ $LIMINE assente — skip (boot loader diverso?)"
    exit 0
fi

if ! sudo grep -q "//linux-cachyos$" "$LIMINE" 2>/dev/null; then
    echo "→ entry '//linux-cachyos' non trovata in $LIMINE — skip"
    exit 0
fi

# Verifico se i parametri sono già presenti in una entry kernel (non snapshot)
if sudo grep -q "rootflags=subvol=/@ .* amdgpu.dcdebugmask=0x10" "$LIMINE" 2>/dev/null && \
   sudo grep -q "rootflags=subvol=/@ .* amdgpu.dpm=0" "$LIMINE" 2>/dev/null; then
    echo "✓ amdgpu flicker workaround già presente in $LIMINE"
    exit 0
fi

BACKUP="$LIMINE.bak.$(date +%s)"
sudo cp "$LIMINE" "$BACKUP"
echo "→ backup creato: $BACKUP"

# Aggiungo i parametri in coda alla riga cmdline delle entry kernel (linux-cachyos + lts)
# Matcha solo rootflags=subvol=/@ seguito da spazio (esclude snapshot che hanno /@/.snapshots/)
for PARAM in $PARAMS; do
    sudo sed -i '/rootflags=subvol=\/@ /{'"$PARAM"'/!s|$| '"$PARAM"'|}' "$LIMINE"
done

echo "→ amdgpu flicker workaround applicato in $LIMINE (reboot per attivare)"
{{- else -}}
#!/usr/bin/env bash
# .disable_amdgpu_psr = false → no-op
echo "→ disable_amdgpu_psr=false → skip patch limine.conf"
{{- end -}}
