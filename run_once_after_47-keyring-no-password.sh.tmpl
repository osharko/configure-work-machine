{{- if .passwordless_keyring -}}
#!/usr/bin/env bash
# Gnome keyring "Login" → no password.
#
# Razionale: autologin tty1 non fa digitare la password user al boot, quindi
# PAM non può auto-sbloccare il keyring. Risultato: ogni app che usa libsecret
# (Claude, Brave, GitHub CLI, ...) chiede di sbloccare il keyring ad ogni avvio.
#
# Soluzione: keyring senza password. Lecito su macchina LUKS (gate hardware
# è la passphrase LUKS al boot; keyring secondario non aggiunge sicurezza).
#
# Abilitato SOLO se .passwordless_keyring == true (vedi .env).
set -euo pipefail

KEYRING_DIR="$HOME/.local/share/keyrings"
LOGIN="$KEYRING_DIR/login.keyring"
DEFAULT="$KEYRING_DIR/default"

mkdir -p "$KEYRING_DIR"
chmod 0700 "$KEYRING_DIR"

# Se esiste un keyring cifrato (header "GnomeKey"), backupalo e ricrea
if [ -f "$LOGIN" ] && head -c 8 "$LOGIN" 2>/dev/null | grep -q '^GnomeKey'; then
    BACKUP="${LOGIN}.bak.$(date +%s)"
    echo "→ Keyring login cifrato trovato → backup in $BACKUP"
    mv "$LOGIN" "$BACKUP"
fi

# Crea keyring "no password" se manca
if [ ! -f "$LOGIN" ]; then
    echo "→ Creo keyring login no-password (formato ASCII, no encryption)"
    cat > "$LOGIN" <<EOF
[keyring]
display-name=Login
ctime=$(date +%s)
mtime=0
lock-on-idle=false
lock-after=false
EOF
    chmod 0600 "$LOGIN"
fi

# Imposta come default
echo -n "login" > "$DEFAULT"
chmod 0600 "$DEFAULT"

# Reload gnome-keyring-daemon (idempotente)
killall -HUP gnome-keyring-daemon 2>/dev/null || true

echo "✓ Keyring login no-password attivo (LUKS-protected macchina)"
{{- else -}}
#!/usr/bin/env bash
# passwordless_keyring=false → no-op
echo "→ passwordless_keyring=false, skip"
{{- end -}}
