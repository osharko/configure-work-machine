# .env.personal.example — alternativa al vault 1Password "PersonalConfiguration"
#
# Quando usarlo: macchine dove non vuoi/puoi installare 1Password desktop.
# Setta VAULT_PROVIDER=env in config.env e copia questo file in
# ~/.config/configure-work-machine/secrets.env (NON committarlo).
#
# Equivalente all'item 1P:
#   PersonalConfiguration/Identity (Login)        → Email + User
#   PersonalConfiguration/Default (SSH Key)       → public key (+ private agent)
#
# ─── Convenzione: tutte le righe sono COMMENTATE ────────────────────────
# Decommenta + edita SOLO i campi che vuoi popolare. basic-config.sh
# valida il file dopo il source: errore se i required (EMAIL, GIT_NAME)
# restano vuoti.

# EMAIL="me@example.com"
# GIT_NAME="My Full Name"

# Public SSH key (usata da git per signing + opzionale authorized_keys).
# SIGNING_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... me@example.com"

# 1Password account URL — lascia commentato se NON hai 1P installato del tutto.
# Se hai 1P solo per agent SSH (ma vault env per il resto), metti il tuo URL.
# OP_ACCOUNT_URL="my.1password.com"

# Private key (formato OpenSSH multilinea) — opzionale.
# Se non valorizzata, deployerai manualmente ~/.ssh/id_ed25519 (chmod 0600).
# Se popolata, lo script 45-ssh-keys la scrive in ~/.ssh/id_ed25519.
# PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
