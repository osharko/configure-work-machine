# .env.config.example
#
# Variabili "config" passabili via env CLI prima del bootstrap. Ogni var qui
# è equivalente a `VAR=val bash -c "$(curl ...)"` ma persistente in un file
# per non doverle riscrivere a ogni rilancio.
#
# Per usarlo: copia in ~/.config/configure-work-machine/config.env (rigenerato
# anche da basic-config.sh in modo interattivo se mancante).
#
# NB: identità + secret stanno fuori da qui — vedi .env.personal.example
# (o vault 1Password se VAULT_PROVIDER=1password).
#
# ─── Convenzione: tutte le righe sono COMMENTATE ────────────────────────
# Decommenta solo le var che vuoi forzare; le altre vengono chieste in TUI
# o usano i default hardcoded in basic-config.sh/full-config.sh.

# ─── Host flags ─────────────────────────────────────────────────────────
# HOSTNAME_VAL="my-laptop"
# HAS_FINGERPRINT="false"
# AUTOLOGIN_TTY="true"          # richiede LUKS
# PASSWORDLESS_SUDO="true"      # richiede LUKS
# PASSWORDLESS_KEYRING="true"   # richiede LUKS
# SSHD_ENABLED="true"
# DISABLE_AMDGPU_PSR="false"    # true se vedi flicker (Krackan iGPU)

# ─── Moduli opzionali ───────────────────────────────────────────────────
# Profili installazione: CSV di {base,dev,work,gaming,mediacenter}
# INSTALL_PROFILES="base,dev,work"
# USE_NOCTALIA_CONFIG="true"
# DOWNLOAD_WALLPAPERS="true"
# NOCTALIA_FORCE_REFRESH="false"  # true: override tweak UI ad ogni apply

# ─── Distrobox ──────────────────────────────────────────────────────────
# CSV `name1|image1,name2|image2` — vuoto = niente distrobox
# DISTROBOXES="dev|fedora:latest,clean|archlinux:latest"

# ─── Vault provider ─────────────────────────────────────────────────────
# VAULT_PROVIDER="1password"        # alternativa: "env" (usa .env.personal)
# OP_ACCOUNT_URL="my.1password.com"
# OP_VAULT="PersonalConfiguration"
# OP_IDENTITY_ITEM="Identity"
# OP_SSH_ITEM="Default"
# AUTHORIZED_KEYS_FALLBACK="true"

# SSH identities extra (CSV di nomi vault 1P, es. "Work,Client1").
# Vuoto = solo identità default del PersonalConfiguration vault.
# Lo script run_once_after_46-ssh-identities itera tutti gli SSH Key items
# di ognuno + supporta ricorsione tramite item Secure Note `_ssh-refs`.
# SSH_EXTRA_IDENTITIES="Work,Client1"
