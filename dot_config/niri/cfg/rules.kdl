    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    // ─── Floating app rules (porting da omarchy) ──────────────────────────
    // App che si aprono come finestra "windowed" (no tiling scrollable)
    // Solo per app effettivamente installate sul sistema.

    // Telegram → 400x600
    window-rule {
        match app-id=r#"^org\.telegram\.desktop$"#
        open-floating true
        default-column-width { fixed 400; }
        default-window-height { fixed 600; }
    }

    // Nautilus → floating
    window-rule {
        match app-id=r#"^org\.gnome\.Nautilus$"#
        open-floating true
        default-column-width { fixed 1100; }
        default-window-height { fixed 700; }
    }

    // Blanket (ambient sound) → 1000x800
    window-rule {
        match app-id=r#"^com\.rafaelmardojai\.Blanket$"#
        open-floating true
        default-column-width { fixed 1000; }
        default-window-height { fixed 800; }
    }

    // 1Password → floating
    window-rule {
        match app-id=r#"^1Password$"#
        open-floating true
        default-column-width { fixed 1000; }
        default-window-height { fixed 700; }
    }

    // pavucontrol → floating
    window-rule {
        match app-id=r#"^pavucontrol$"#
        open-floating true
        default-column-width { fixed 800; }
        default-window-height { fixed 600; }
    }

    // Signal Desktop → floating (è una chat, simile a telegram)
    window-rule {
        match app-id=r#"^signal$"#
        open-floating true
        default-column-width { fixed 900; }
        default-window-height { fixed 700; }
    }

    // Alacritty → floating
    window-rule {
        match app-id=r#"^Alacritty$"#
        open-floating true
        default-column-width { fixed 1000; }
        default-window-height { fixed 650; }
    }

