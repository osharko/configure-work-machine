#!/usr/bin/env bash
# Hook pre-commit globale: setta user.email + user.name del repo corrente
# in base al vault SSH risolto dal remote URL.
#
# Funzionamento: stessa lib del wrapper signing → estrae il vault dalla
# identityfile risolta da ssh -G → legge ~/.gitconfig.d/<vault>.gitconfig
# (generato da 46-ssh-identities) → scrive user.email/user.name nel
# .git/config locale del repo. Idempotente: ricomputa ad ogni commit.
#
# Composizione con hook locali: dopo il nostro lavoro, deleghiamo a
# .git/hooks/pre-commit del repo se esiste, per non rompere setup come
# husky/pre-commit framework. Se il local hook esce non-zero, propaghiamo.
#
# Failure mode: tutti gli step di resolve/parse sono opzionali. Mai exit
# non-zero per fallimento di resolve — bloccherebbe il commit.

set -uo pipefail

# shellcheck source=/dev/null
. "$HOME/.local/lib/git-ctx-resolve.sh"

if git_ctx_resolve && [ -n "$VAULT_GITCONFIG" ]; then
    target_email=$(git config -f "$VAULT_GITCONFIG" --get user.email 2>/dev/null || true)
    target_name=$(git config -f "$VAULT_GITCONFIG" --get user.name 2>/dev/null || true)
    effective_email=$(git config --get user.email 2>/dev/null || true)
    effective_name=$(git config --get user.name 2>/dev/null || true)

    needs_retry=0
    if [ -n "$target_email" ] && [ "$effective_email" != "$target_email" ]; then
        git config --local user.email "$target_email"
        needs_retry=1
    fi
    if [ -n "$target_name" ] && [ "$effective_name" != "$target_name" ]; then
        git config --local user.name "$target_name"
        needs_retry=1
    fi

    if [ "$needs_retry" = "1" ]; then
        # Git ha già caricato user.email/name PRIMA di chiamare pre-commit:
        # se procedessimo ora, il commit userebbe i valori vecchi. Abortiamo
        # con exit 1 e lasciamo che l'utente rilanci — al secondo giro il
        # config locale è già settato, no mismatch, no abort.
        cat <<EOF >&2

⚠  Identità non allineata al vault '$VAULT' rilevato dal remote del repo.
   Aggiornata config locale del repo:
EOF
        [ -n "$target_email" ] && [ "$effective_email" != "$target_email" ] && \
            printf "     user.email:  %s → %s\n" "$effective_email" "$target_email" >&2
        [ -n "$target_name" ]  && [ "$effective_name"  != "$target_name"  ] && \
            printf "     user.name:   %s → %s\n" "$effective_name" "$target_name" >&2
        cat <<EOF >&2

   Rilancia il commit (la stage è preservata). Per saltare il guard
   una tantum: 'git commit --no-verify'.
EOF
        exit 1
    fi
fi

# Chain a eventuale hook locale del repo (compat husky/pre-commit framework).
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || true)
LOCAL_HOOK="${GIT_DIR}/hooks/pre-commit"
if [ -n "$GIT_DIR" ] && [ -x "$LOCAL_HOOK" ]; then
    # Evita ricorsione se per qualche bizzarria $LOCAL_HOOK == questo file
    if [ "$(readlink -f "$LOCAL_HOOK" 2>/dev/null)" != "$(readlink -f "$0" 2>/dev/null)" ]; then
        exec "$LOCAL_HOOK" "$@"
    fi
fi
exit 0
