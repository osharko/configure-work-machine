# .env.work.example — alternativa al vault 1Password "Work" (o altro nome
# vault aggiuntivo dichiarato in SSH_EXTRA_IDENTITIES).
#
# Stessa filosofia di .env.personal.example ma per identità non-default.
# Solo necessario se VAULT_PROVIDER=env E vuoi le identità extra senza 1P.
#
# NB: il sistema 1P-based è preferito perché supporta ricorsione (item
# `_ssh-refs`), private key via agent (no chiavi su disco), refresh auto.
# Questo file serve come fallback per ambienti senza 1P.
#
# Caricamento multi-file: nel basic-config.sh la logica di source secrets.env
# va estesa per accettare più file (TODO ROADMAP).
#
# ─── Convenzione: tutte le righe sono COMMENTATE ────────────────────────

# EMAIL="myname@company.com"
# GIT_NAME="My Full Name"

# SSH key per gli host della tua organizzazione (es. gitlab.azienda.it).
# WORK_SSH_PUBLIC="ssh-ed25519 AAAA... myname@company.com"
# WORK_SSH_PRIVATE=""

# Snippet ssh_config — verrà scritto in ~/.ssh/config.d/work.conf
# WORK_SSH_CONFIG="
# Host gitlab.azienda.it *.azienda.it
#     User myname
#     IdentityFile ~/.ssh/work.pub
#     IdentitiesOnly yes
# "
