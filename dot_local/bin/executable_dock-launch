#!/usr/bin/env bash
# Lancia il pinned dock #N di Noctalia.
# v5: legge ~/.local/state/noctalia/settings.toml → dock.pinned[N-1]
# Risolve il desktop-id via gtk-launch (no .desktop suffix).
# No-op silenzioso se posizione vuota.

set -euo pipefail
N="${1:-}"
[ -z "$N" ] && exit 0

STATE_TOML="$HOME/.local/state/noctalia/settings.toml"
SETTINGS_JSON="$HOME/.config/noctalia/settings.json"

APP=""
if [ -f "$STATE_TOML" ]; then
    # v5 TOML: dock.pinned = ["app1", "app2"]
    APP=$(grep -A20 '^\[dock\]' "$STATE_TOML" | grep -oP 'pinned\s*=\s*\[\K[^]]+' | cut -d'"' -f2 | sed -n "${N}p")
elif [ -f "$SETTINGS_JSON" ]; then
    # v4 JSON fallback: dock.pinnedApps
    APP=$(jq -r ".dock.pinnedApps[$((N-1))] // empty" "$SETTINGS_JSON" 2>/dev/null)
fi
[ -z "$APP" ] && exit 0   # no-op

# gtk-launch accetta desktop-id (case-sensitive). Match anche fuzzy come fallback.
if gtk-launch "$APP" 2>/dev/null; then
    exit 0
fi

# Fallback: cerca .desktop case-insensitive
for dir in \
    "$HOME/.local/share/applications" \
    /usr/share/applications \
    /var/lib/flatpak/exports/share/applications \
    "$HOME/.local/share/flatpak/exports/share/applications"
do
    [ -d "$dir" ] || continue
    f=$(find "$dir" -maxdepth 1 -iname "${APP}.desktop" 2>/dev/null | head -1)
    if [ -n "$f" ]; then
        gtk-launch "$(basename "$f" .desktop)"
        exit 0
    fi
done

# nessun match
exit 0
