[Desktop Entry]
Type=Application
Name=Image Viewer (folder)
GenericName=Image Viewer
Comment=Apre imv mostrando l'intera cartella del file selezionato (scorri con n/p)
Exec=imv-folder %F
TryExec=imv-folder
Icon=image-viewer
Terminal=false
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/tiff;image/webp;image/x-bmp;image/x-pcx;image/x-png;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xbitmap;image/x-xpixmap;image/svg+xml;
Categories=Graphics;2DGraphics;Viewer;
StartupNotify=true
NoDisplay=false
